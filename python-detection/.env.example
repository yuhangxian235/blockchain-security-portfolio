# Copy this file to ".env" and fill in your own key. Never commit the real .env.
# Alchemy/Infura Ethereum mainnet HTTPS endpoint
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/PASTE_YOUR_KEY

# Optional, used later for cross-chain tracing
BSC_RPC_URL=https://bsc-dataseed.binance.org
TRON_RPC_URL=https://api.trongrid.io
